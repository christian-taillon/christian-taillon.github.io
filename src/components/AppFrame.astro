---
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  src: string;
}

const { title, description, src } = Astro.props;
---
<BaseLayout title={title} description={description} footer={false}>
  <iframe
    src={src}
    title={title}
    class="block w-full border-0 bg-background"
    style="height: calc(100vh - 3.5rem);"
    loading="eager"
  ></iframe>
</BaseLayout>

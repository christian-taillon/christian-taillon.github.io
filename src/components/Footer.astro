---
import SiteLogo from '@/components/SiteLogo.astro';
import { SITE } from '@/data/site';
---
<footer class="mt-20 border-t border-ink-foreground/10 bg-ink text-ink-foreground">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <SiteLogo />
      <p class="mt-3 max-w-md text-sm leading-6 text-ink-foreground/60">Practical cybersecurity, AI, engineering notes, tools, and community resources.</p>
    </div>
    <div>
      <h2 class="text-sm font-semibold text-primary">Explore</h2>
      <div class="mt-3 grid gap-2 text-sm text-ink-foreground/65">
        <a href="/cyberresources" class="hover:text-ink-foreground">Cybersecurity resources</a>
        <a href="/coding-agent-explorer/" class="hover:text-ink-foreground">Coding Agent Explorer</a>
        <a href="/phoenix-cybersecurity-events" class="hover:text-ink-foreground">Phoenix cyber community</a>
      </div>
    </div>
    <div>
      <h2 class="text-sm font-semibold text-primary">Connect</h2>
      <div class="mt-3 grid gap-2 text-sm text-ink-foreground/65">
        <a href={SITE.linkedin} class="hover:text-ink-foreground">LinkedIn</a>
        <a href={SITE.github} class="hover:text-ink-foreground">GitHub</a>
        <a href={`mailto:${SITE.email}`} class="hover:text-ink-foreground">{SITE.email}</a>
      </div>
    </div>
  </div>
  <div class="border-t border-ink-foreground/10 px-4 py-5 text-center text-xs text-ink-foreground/45">© {new Date().getFullYear()} Christian Taillon. Built on AstroDeck.</div>
</footer>

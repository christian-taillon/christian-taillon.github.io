---
import { SITE } from '@/data/site';
---

<footer class="mt-20 border-t">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-2">
    <div>
      <p class="font-semibold">{SITE.name}</p>
      <p class="mt-2 max-w-lg text-sm leading-6 text-muted-foreground">
        Cybersecurity, threat intelligence, AI security, engineering notes, tools, and practical guides.
      </p>
    </div>
    <div class="flex flex-wrap gap-x-5 gap-y-3 md:justify-end">
      <a class="text-sm text-muted-foreground hover:text-foreground" href={SITE.github}>GitHub</a>
      <a class="text-sm text-muted-foreground hover:text-foreground" href={SITE.linkedin}>LinkedIn</a>
      <a class="text-sm text-muted-foreground hover:text-foreground" href={SITE.medium}>Medium</a>
      <a class="text-sm text-muted-foreground hover:text-foreground" href={SITE.email}>Email</a>
    </div>
  </div>
</footer>

---
import SiteLogo from '@/components/SiteLogo.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { NAV, SITE } from '@/data/site';

const currentPath = Astro.url.pathname;
const isExternal = (href: string) => /^https?:\/\//.test(href);
const isActive = (href: string) => {
  if (isExternal(href)) return false;
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href.replace(/\/$/, ''));
};
---

<header class="sticky top-0 z-50 border-b border-ink-foreground/10 bg-ink/95 text-ink-foreground backdrop-blur">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <SiteLogo />

    <nav class="hidden h-full items-center gap-1 lg:flex" aria-label="Primary navigation">
      {
        NAV.map((item) => {
          if ('items' in item) {
            const active = item.items.some((child) => isActive(child.href));
            return (
              <details class="nav-dropdown group relative h-full">
                <summary
                  class:list={[
                    'flex h-full cursor-pointer list-none items-center gap-1.5 px-2.5 text-sm transition-colors marker:hidden',
                    active
                      ? 'font-semibold text-primary'
                      : 'text-ink-foreground/70 hover:text-ink-foreground',
                  ]}
                >
                  <span>{item.label}</span>
                  <svg
                    class="h-3.5 w-3.5 transition-transform group-open:rotate-180"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M5.2 7.4a.75.75 0 0 1 1.06 0L10 11.14l3.74-3.74a.75.75 0 1 1 1.06 1.06l-4.27 4.27a.75.75 0 0 1-1.06 0L5.2 8.46a.75.75 0 0 1 0-1.06Z" />
                  </svg>
                </summary>
                <div class="absolute left-0 top-full z-50 w-80 pt-2">
                  <div class="max-h-[70vh] overflow-y-auto rounded-xl border border-ink-foreground/10 bg-ink p-2 shadow-2xl">
                    {item.items.map((child) => (
                      <a
                        href={child.href}
                        target={isExternal(child.href) ? '_blank' : undefined}
                        rel={isExternal(child.href) ? 'noopener noreferrer' : undefined}
                        class:list={[
                          'flex rounded-lg px-3 py-2.5 text-sm leading-5 transition-colors',
                          isActive(child.href)
                            ? 'bg-primary/10 font-semibold text-primary'
                            : 'text-ink-foreground/70 hover:bg-ink-foreground/8 hover:text-ink-foreground',
                        ]}
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              </details>
            );
          }

          return (
            <a
              href={item.href}
              class:list={[
                'flex h-full items-center px-2.5 text-sm transition-colors',
                isActive(item.href)
                  ? 'font-semibold text-primary'
                  : 'text-ink-foreground/70 hover:text-ink-foreground',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-full border border-primary/50 px-3 py-1.5 text-xs font-semibold text-primary transition-colors hover:bg-primary hover:text-primary-foreground sm:inline-flex"
      >
        GitHub
      </a>
      <button
        id="menu-button"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-ink-foreground/80 hover:bg-ink-foreground/10 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden max-h-[calc(100vh-3.5rem)] overflow-y-auto border-t border-ink-foreground/10 px-4 py-3 lg:hidden"
    aria-label="Mobile navigation"
  >
    <div class="mx-auto grid max-w-7xl gap-1">
      {
        NAV.map((item) => {
          if ('items' in item) {
            return (
              <details class="group rounded-lg">
                <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2.5 text-sm font-semibold text-ink-foreground/80 hover:bg-ink-foreground/10 marker:hidden">
                  <span>{item.label}</span>
                  <svg
                    class="h-4 w-4 transition-transform group-open:rotate-180"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M5.2 7.4a.75.75 0 0 1 1.06 0L10 11.14l3.74-3.74a.75.75 0 1 1 1.06 1.06l-4.27 4.27a.75.75 0 0 1-1.06 0L5.2 8.46a.75.75 0 0 1 0-1.06Z" />
                  </svg>
                </summary>
                <div class="ml-3 border-l border-ink-foreground/10 py-1 pl-2">
                  {item.items.map((child) => (
                    <a
                      href={child.href}
                      target={isExternal(child.href) ? '_blank' : undefined}
                      rel={isExternal(child.href) ? 'noopener noreferrer' : undefined}
                      class:list={[
                        'block rounded-md px-3 py-2 text-sm leading-5',
                        isActive(child.href)
                          ? 'font-semibold text-primary'
                          : 'text-ink-foreground/65 hover:bg-ink-foreground/10 hover:text-ink-foreground',
                      ]}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </details>
            );
          }

          return (
            <a
              href={item.href}
              class:list={[
                'rounded-lg px-3 py-2.5 text-sm font-semibold',
                isActive(item.href)
                  ? 'text-primary'
                  : 'text-ink-foreground/80 hover:bg-ink-foreground/10',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
      <a
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg px-3 py-2.5 text-sm font-semibold text-primary hover:bg-ink-foreground/10 sm:hidden"
      >
        GitHub
      </a>
    </div>
  </nav>
</header>

<script>
  function initMenu() {
    const button = document.getElementById('menu-button');
    const menu = document.getElementById('mobile-menu');
    if (!button || !menu) return;

    button.onclick = () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      menu.classList.toggle('hidden', open);
    };
  }

  initMenu();
  document.addEventListener('astro:after-swap', initMenu);
</script>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>

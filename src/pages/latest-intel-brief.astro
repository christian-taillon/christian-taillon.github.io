---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const briefs = await getCollection('briefs');
const latest = briefs.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];
const rendered = latest ? await render(latest) : undefined;
const Content = rendered?.Content;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<BaseLayout
  title="Latest Intel Brief"
  description="The latest tactical threat intelligence brief published on christiant.io."
>
  <article class="mx-auto max-w-5xl px-4 py-14 sm:px-6 md:py-20">
    <header>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-red">Threat Intelligence</p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight md:text-6xl">Latest Intel Brief</h1>
    </header>

    {latest && Content ? (
      <section class="mt-10">
        <p class="text-sm font-medium text-muted-foreground">{formatDate(latest.data.date)}</p>
        <h2 class="mt-2 text-2xl font-semibold">{latest.data.title}</h2>
        <div class="prose prose-neutral dark:prose-invert mt-8 max-w-none">
          <Content />
        </div>
      </section>
    ) : (
      <p class="mt-8 text-muted-foreground">No intelligence briefs are available.</p>
    )}
  </article>
</BaseLayout>

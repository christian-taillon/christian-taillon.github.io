source "https://rubygems.org"

# Local development stack. Keep this aligned with _config.yml.
gem "jekyll", "~> 4.4"

# Ruby 4 no longer provides logger as a default gem, while current Jekyll
# still expects it during startup.
gem "logger"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-remote-theme"
  gem "jekyll-include-cache"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
end
